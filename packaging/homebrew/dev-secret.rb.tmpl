# Reference formula for the tap repository (github.com/sibest19/homebrew-tap,
# file Formula/dev-secret.rb). Replace @VERSION@ and @SHA256@ with the values
# the release workflow prints in its job summary.
class DevSecret < Formula
  desc "Keep developer secrets in a macOS keychain and expose them per command"
  homepage "https://github.com/sibest19/dev-secret"
  url "https://github.com/sibest19/dev-secret/releases/download/v@VERSION@/dev-secret-@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"

  depends_on :macos

  def install
    bin.install "bin/dev-secret"
    man1.install "man/dev-secret.1"
    bash_completion.install "completions/dev-secret.bash" => "dev-secret"
    zsh_completion.install "completions/_dev-secret"
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/dev-secret version").strip
    assert_match "Usage:", shell_output("#{bin}/dev-secret help")
  end
end
