#compdef dev-secret
# zsh completion for dev-secret.
# Secret names are deliberately not completed: listing them unlocks the
# keychain, and pressing <Tab> must never trigger a password or Touch ID prompt.

_dev-secret() {
  local -a commands
  commands=(
    'init:create the dedicated keychain and config'
    'set:store a secret'
    'get:print a secret to stdout'
    'run:run a command with secrets in its environment'
    'list:list stored secret names'
    'delete:delete a secret'
    'keychain:lock, unlock or configure the keychain'
    'doctor:check the environment'
    'scan-env:find plaintext secrets in shell rc files'
    'import-env:move plaintext secrets from rc files into the keychain'
    'help:show usage'
    'version:show version'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'dev-secret command' commands
    return
  fi

  local cmd=$words[2]
  shift words
  (( CURRENT-- ))

  case $cmd in
    init)
      _arguments '--defaults[install a defaults file]:defaults file:_files'
      ;;
    set)
      _arguments '1:secret name (ENV_VAR style): ' '--stdin[read the value from stdin]'
      ;;
    get|delete|rm)
      _message 'secret name'
      ;;
    run)
      local sep=${words[(i)--]}
      if (( sep < CURRENT )); then
        shift $sep words
        (( CURRENT -= sep ))
        _normal
      else
        _message 'secret names, then -- command [args...]'
      fi
      ;;
    keychain)
      if (( CURRENT == 2 )); then
        _values 'keychain command' biometric lock unlock status
      elif (( CURRENT == 3 )) && [[ $words[2] == biometric ]]; then
        _values 'biometric command' enable disable status
      fi
      ;;
    scan-env)
      _files
      ;;
    import-env)
      _arguments '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' '*:rc file:_files'
      ;;
  esac
}

_dev-secret "$@"
