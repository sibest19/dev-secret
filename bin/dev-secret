set -euo pipefail
IFS=$'\n\t'

VERSION="0.4.0"
APP_NAME="dev-secret"
KEYCHAIN_NAME="${DEV_SECRET_KEYCHAIN_NAME:-dev-secrets}"
KEYCHAIN_PATH="${DEV_SECRET_KEYCHAIN_PATH:-$HOME/Library/Keychains/${KEYCHAIN_NAME}.keychain-db}"
CONFIG_DIR="${DEV_SECRET_CONFIG_DIR:-$HOME/.config/dev-secret}"
DEFAULTS_FILE="${DEV_SECRET_DEFAULTS_FILE:-$CONFIG_DIR/defaults}"
SERVICE_PREFIX="${DEV_SECRET_SERVICE_PREFIX:-it.simoneandreani.dev-secret}"
SCAN_FILES=("$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.zshenv" "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc")
LOGIN_KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
ENROLL_SERVICE="${SERVICE_PREFIX}.keychain-unlock"
ENROLL_ACCOUNT="keychain-password"
BIOMETRIC_FLAG="$CONFIG_DIR/.biometric-enabled"

say() { printf '%s\n' "$*"; }
info() { printf '%s\n' "$*" >&2; }
die() {
	printf 'Error: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<USAGE
$APP_NAME $VERSION

Usage:
  $APP_NAME init [--defaults FILE]
  $APP_NAME set NAME [--stdin]
  $APP_NAME get NAME
  $APP_NAME run NAME [NAME ...] -- command [args...]
  $APP_NAME list
  $APP_NAME delete NAME
  $APP_NAME keychain biometric enable|disable|status
  $APP_NAME keychain lock|unlock|status
  $APP_NAME doctor
  $APP_NAME scan-env [FILE ...]
  $APP_NAME import-env [--yes] [FILE ...]
  $APP_NAME help
  $APP_NAME version
USAGE
}

require_macos_security() {
	[[ "${OSTYPE:-}" == darwin* ]] || die "$APP_NAME requires macOS because it uses the native Keychain."
	command -v security >/dev/null 2>&1 || die "macOS security command not found."
}

service_name_for() {
	printf '%s.%s' "$SERVICE_PREFIX" "$1"
}

valid_secret_name() {
	[[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

require_secret_name() {
	local name="${1:-}"
	[[ -n "$name" ]] || die "Missing secret name."
	valid_secret_name "$name" || die "Invalid secret name '$name'. Use ENV_VAR style names."
}

ensure_config_dir() {
	mkdir -p "$CONFIG_DIR"
	chmod 700 "$CONFIG_DIR" 2>/dev/null || true
}

keychain_exists() {
	[[ -f "$KEYCHAIN_PATH" ]]
}

# Touch ID via LocalAuthentication.
#   touchid_authenticate check          only test whether biometrics can be used
#                                       right now; this never shows a prompt
#   touchid_authenticate prompt REASON  ask for Touch ID; macOS shows
#                                       "<app> is trying to REASON."
#   touchid_authenticate prompt REASON REQUESTER NAME_COUNT NAME... ARGV...
#                                       the same, with a panel below the prompt
#                                       that shows the whole request
# Prompts from every dev-secret process of this user take turns, so a panel is
# never on screen with another request's prompt.
# Returns: 0 authenticated (or usable), 1 failed, cancelled or interrupted,
#          2 no usable biometrics, 3 locked out, 4 swift not installed,
#          5 could not take turns with other prompts.
# Only 2, 3 and 4 mean "use the keychain password instead".
touchid_authenticate() {
	local mode="$1" reason="${2:-}"
	command -v swift >/dev/null 2>&1 || return 4
	if (($# > 2)); then
		shift 2
		# Bash 3.2 here-strings and heredocs use temp files. Send only the
		# static Swift source that way; stream the request fields on a pipe.
		touchid_swift "$mode" "$reason" 1 3< <(printf '%s\0' "$@")
	else
		touchid_swift "$mode" "$reason" 0 3<&-
	fi
}

touchid_swift() {
	DEV_SECRET_TOUCHID_CHECK_ONLY="$1" DEV_SECRET_TOUCHID_REASON="$2" \
		DEV_SECRET_TOUCHID_DETAILS="$3" DEV_SECRET_TOUCHID_CALLER="$$" \
		swift - 4>&2 2>/dev/null <<'SWIFT'
import AppKit
import CoreFoundation
import Darwin
import LocalAuthentication

private let policy = LAPolicy.deviceOwnerAuthenticationWithBiometrics
private let interruptionSignals = [SIGINT, SIGTERM, SIGHUP, SIGQUIT]

private func preflight(_ context: LAContext) -> Int32 {
    var error: NSError?
    if context.canEvaluatePolicy(policy, error: &error) { return 0 }
    guard let error, error.domain == LAError.errorDomain, let code = LAError.Code(rawValue: error.code)
    else { return 1 }
    switch code {
    case .biometryNotAvailable, .biometryNotEnrolled, .biometryNotPaired, .biometryDisconnected,
         .passcodeNotSet: return 2
    case .biometryLockout: return 3
    default: return 1
    }
}

private enum CoordinationError: Error {
    case invalidLock
    case system(String, Int32)

    var message: String {
        switch self {
        case .invalidLock: return "expected an empty, private regular lock file"
        case let .system(operation, code): return "\(operation) failed (errno \(code))"
        }
    }
}

private func openCoordinationFile() throws -> Int32 {
    // Use the OS's per-user directory, independent of each process's TMPDIR.
    let size = confstr(_CS_DARWIN_USER_TEMP_DIR, nil, 0)
    guard size > 1 else { throw CoordinationError.system("finding the per-user directory", errno) }
    var path = [CChar](repeating: 0, count: size)
    guard confstr(_CS_DARWIN_USER_TEMP_DIR, &path, size) == size else {
        throw CoordinationError.system("finding the per-user directory", errno)
    }
    let directory = String(decoding: path.prefix { $0 != 0 }.map { UInt8(bitPattern: $0) }, as: UTF8.self)
    let file = (directory as NSString).appendingPathComponent("dev-secret-touch-id.lock")
    let flags = O_RDWR | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK

    // Create privately even with a restrictive inherited umask. Only the
    // creator sets the mode; never repair or unlink an existing lock inode.
    let mask = umask(0o077)
    let created = open(file, flags | O_CREAT | O_EXCL, 0o600)
    let createError = errno
    umask(mask)
    let fd: Int32
    if created >= 0 {
        fd = created
        guard fchmod(fd, 0o600) == 0 else { throw CoordinationError.system("fchmod", errno) }
    } else if createError == EEXIST {
        fd = open(file, flags)
        guard fd >= 0 else { throw CoordinationError.system("opening the lock", errno) }
    } else {
        throw CoordinationError.system("creating the lock", createError)
    }
    var info = stat()
    guard fstat(fd, &info) == 0 else { throw CoordinationError.system("fstat", errno) }
    guard info.st_mode & S_IFMT == S_IFREG, info.st_mode & 0o7777 == 0o600,
          info.st_uid == geteuid(), info.st_nlink == 1, info.st_size == 0
    else { throw CoordinationError.invalidLock }
    return fd
}

private func displayField(_ bytes: Data) -> String {
    // Invalid UTF-8 still represents real argv bytes. Do not conflate it with
    // replacement characters that might themselves be present in an argument.
    guard let argument = String(data: bytes, encoding: .utf8) else {
        return "\"" + bytes.map { String(format: "\\x%02X", $0) }.joined() + "\""
    }
    var display = "\""
    for scalar in argument.unicodeScalars {
        switch scalar {
        case "\"": display += "\\\""
        case "\\": display += "\\\\"
        case "\n": display += "\\n"
        case "\r": display += "\\r"
        case "\t": display += "\\t"
        default:
            let category = scalar.properties.generalCategory
            if category == .control || category == .format
                || category == .lineSeparator || category == .paragraphSeparator
                || scalar.properties.isDefaultIgnorableCodePoint {
                display += "\\u{\(String(scalar.value, radix: 16, uppercase: true))}"
            } else {
                display.unicodeScalars.append(scalar)
            }
        }
    }
    return display + "\""
}

private func readDetails() -> String? {
    var info = stat()
    guard fstat(3, &info) == 0, info.st_mode & S_IFMT == S_IFIFO else { return nil }
    let input = FileHandle(fileDescriptor: 3, closeOnDealloc: true)
    guard let bytes = try? input.readToEnd(), bytes.last == 0 else { return nil }
    let fields = bytes.dropLast().split(separator: 0, omittingEmptySubsequences: false)
    guard fields.count >= 4, let count = Int(String(decoding: fields[1], as: UTF8.self)),
          count > 0, count <= fields.count - 3 else { return nil }
    let requester = fields[0].isEmpty ? "" : "Requester: \(displayField(fields[0]))\n\n"
    let names = fields[2..<(2 + count)].map(displayField).joined(separator: ", ")
    let command = fields.dropFirst(2 + count).map(displayField).joined(separator: " ")
    return "\(requester)Secret names (\(count)):\n\(names)\n\nCommand arguments:\n\(command)"
}

private final class DetailsPanel: NSPanel {
    override var canBecomeKey: Bool { false }
    override var canBecomeMain: Bool { false }
}

@MainActor
private func panelFrame() -> NSRect? {
    // AppKit does not expose the native prompt's frame. Use the pointer's
    // screen and leave space around its center for the native prompt.
    guard NSWorkspace.shared.frontmostApplication != nil else { return nil }
    let pointer = NSEvent.mouseLocation
    guard let screen = NSScreen.screens.first(where: { $0.frame.contains(pointer) })
        ?? NSScreen.main else { return nil }
    let visible = screen.visibleFrame
    let top = min(visible.midY, screen.frame.midY) - 136
    let width = min(680, visible.width - 36)
    let height = min(232, top - visible.minY - 14)
    guard width >= 420, height >= 176 else { return nil }
    return NSRect(x: visible.midX - width / 2, y: top - height, width: width, height: height)
}

@MainActor
private func makePanel(frame: NSRect, details: String) -> DetailsPanel? {
    let style: NSWindow.StyleMask = [.titled, .nonactivatingPanel]
    let panel = DetailsPanel(
        contentRect: NSWindow.contentRect(forFrameRect: frame, styleMask: style),
        styleMask: style, backing: .buffered, defer: false)
    panel.title = "dev-secret — Touch ID request details"
    panel.hidesOnDeactivate = false
    panel.isMovable = false
    panel.level = .floating
    panel.collectionBehavior = [.fullScreenAuxiliary, .ignoresCycle]
    panel.setFrame(frame, display: false)
    guard let content = panel.contentView else { return nil }
    let width = content.bounds.width - 32
    let height = content.bounds.height

    let label = NSTextField(labelWithString: "Review the details, then respond in the macOS prompt.")
    label.font = .systemFont(ofSize: 13, weight: .medium)
    label.frame = NSRect(x: 16, y: height - 26, width: width, height: 18)
    content.addSubview(label)

    let scroll = NSScrollView(frame: NSRect(x: 16, y: 12, width: width, height: height - 46))
    scroll.borderType = .bezelBorder
    scroll.hasVerticalScroller = true
    let text = NSTextView(frame: NSRect(origin: .zero, size: scroll.contentSize))
    text.isEditable = false
    // Let assistive technology navigate the full text without taking focus.
    text.isSelectable = true
    text.isRichText = false
    text.font = .systemFont(ofSize: 13)
    text.setAccessibilityLabel("Request details")
    text.textContainerInset = NSSize(width: 8, height: 7)
    text.isHorizontallyResizable = false
    text.isVerticallyResizable = true
    text.minSize = NSSize(width: 0, height: scroll.contentSize.height)
    let unbounded = CGFloat.greatestFiniteMagnitude
    text.maxSize = NSSize(width: unbounded, height: unbounded)
    text.autoresizingMask = [.width]
    text.textContainer?.containerSize = NSSize(width: scroll.contentSize.width, height: unbounded)
    text.textContainer?.widthTracksTextView = true
    scroll.documentView = text
    text.string = details
    content.addSubview(scroll)
    return panel
}

@MainActor
private final class TouchIDRequest {
    private let caller: pid_t
    private let parent = getppid()
    private let reason: String
    private let hasDetails: Bool
    private let diagnostics: Int32
    private var context: LAContext?
    private var panel: DetailsPanel?
    private var eventFD: Int32 = -1
    private var eventSource: DispatchSourceRead?
    private var evaluating = false
    private var stopping = false

    init(caller: pid_t, reason: String, hasDetails: Bool) {
        self.caller = caller
        self.reason = reason.isEmpty ? "unlock the dev-secrets keychain" : reason
        self.hasDetails = hasDetails
        // FD 4 bypasses the suppression of Swift compiler diagnostics. Pin it
        // without changing the caller's shared flags.
        diagnostics = fcntl(4, F_DUPFD_CLOEXEC, 5)
        signal(SIGPIPE, SIG_IGN)
    }

    func run() -> Never {
        do {
            try watchInterruption()
            // The private Bash pipe has a finite request. Drain it before
            // waiting for the lock, so neither process holds the other up.
            let details = hasDetails ? readDetails() : nil
            try acquireLock(openCoordinationFile())
            stopIfInterrupted()

            let context = LAContext()
            self.context = context
            let status = preflight(context)
            stopIfInterrupted()
            if status != 0 { finish(status) }

            if let details, let frame = panelFrame() {
                let app = NSApplication.shared
                if app.setActivationPolicy(.accessory) {
                    DispatchQueue.main.async {
                        self.stopIfInterrupted()
                        if let panel = makePanel(frame: frame, details: details) {
                            self.panel = panel
                            self.stopIfInterrupted()
                            panel.orderFrontRegardless()
                        }
                        self.authenticate()
                    }
                    app.run()
                    stop()
                    dispatchMain()
                }
            }
        } catch {
            // No lock is held on this path, so writing here delays nobody
            // else. Bash also reports the failure from the exit status.
            if diagnostics >= 0, let error = error as? CoordinationError {
                let line = Array(("Touch ID coordination: " + error.message + "\n").utf8)
                line.withUnsafeBytes { _ = Darwin.write(diagnostics, $0.baseAddress, $0.count) }
            }
            finish(5)
        }

        DispatchQueue.main.async { self.authenticate() }
        dispatchMain()
    }

    private func watchInterruption() throws {
        guard parentsAlive() else { finish(1) }
        eventFD = kqueue()
        guard eventFD >= 0 else { throw CoordinationError.system("kqueue", errno) }
        guard fcntl(eventFD, F_SETFD, FD_CLOEXEC) == 0 else { throw CoordinationError.system("fcntl", errno) }

        var events = interruptionSignals.map {
            kevent64_s(ident: UInt64($0), filter: Int16(EVFILT_SIGNAL), flags: UInt16(EV_ADD),
                       fflags: 0, data: 0, udata: 0, ext: (0, 0))
        }
        // swift - can exec the interpreter or leave a driver in between.
        // Watch the actual parent as well as the invoking Bash process.
        for pid in Set([caller, parent]) {
            events.append(kevent64_s(ident: UInt64(pid), filter: Int16(EVFILT_PROC), flags: UInt16(EV_ADD),
                                     fflags: NOTE_EXIT, data: 0, udata: 0, ext: (0, 0)))
        }
        guard kevent64(eventFD, events, Int32(events.count), nil, 0, 0, nil) == 0 else {
            throw CoordinationError.system("registering interruption events", errno)
        }
        // Darwin records process-directed signals even with SIG_IGN.
        for number in interruptionSignals { signal(number, SIG_IGN) }
        let source = DispatchSource.makeReadSource(fileDescriptor: eventFD, queue: .main)
        source.setEventHandler { [weak self] in
            guard let self, !self.stopping, self.interrupted() else { return }
            self.stop()
        }
        eventSource = source
        source.resume()
    }

    private func parentsAlive() -> Bool {
        caller > 1 && parent > 1 && getppid() == parent && (caller == parent || kill(caller, 0) == 0)
    }

    private func interrupted() -> Bool {
        if !parentsAlive() { return true }
        guard eventFD >= 0 else { return false }
        var event = kevent64_s()
        var count: Int32
        repeat {
            count = kevent64(eventFD, nil, 0, &event, 1, UInt32(KEVENT_FLAG_IMMEDIATE), nil)
        } while count < 0 && errno == EINTR
        // Every event on this queue means stop, as does failing to read it.
        return count != 0
    }

    private func stopIfInterrupted() {
        if interrupted() { finish(1) }
    }

    private func acquireLock(_ fd: Int32) throws {
        var waiting = false
        while true {
            stopIfInterrupted()
            if flock(fd, LOCK_EX | LOCK_NB) == 0 {
                // The kernel may have recorded a signal before the handoff,
                // even if the dispatch source has not run yet.
                stopIfInterrupted()
                return
            }
            let code = errno
            guard code == EWOULDBLOCK || code == EINTR else { throw CoordinationError.system("flock", code) }
            if !waiting, diagnostics >= 0 {
                // Say once why nothing is on screen yet. A stalled terminal
                // must not stall this loop, so write off the main thread.
                waiting = true
                let fd = diagnostics
                let line = Array("Touch ID: waiting for another dev-secret request to finish.\n".utf8)
                DispatchQueue.global().async {
                    line.withUnsafeBytes { _ = Darwin.write(fd, $0.baseAddress, $0.count) }
                }
            }
            CFRunLoopRunInMode(.defaultMode, 0.1, false)
        }
    }

    private func authenticate() {
        guard let context else { finish(1) }
        stopIfInterrupted()
        evaluating = true
        context.evaluatePolicy(policy, localizedReason: reason) { success, _ in
            DispatchQueue.main.async {
                self.evaluating = false
                self.finish(success && !self.stopping ? 0 : 1)
            }
        }
    }

    private func stop() {
        guard !stopping else { return }
        guard evaluating else { finish(1) }
        stopping = true
        eventSource?.cancel()
        tearDown()
        // No timeout: the canceled evaluation must reply before we unlock.
    }

    private func tearDown() {
        panel?.orderOut(nil)
        panel?.close()
        panel = nil
        // Keep the invalidated context alive until its callback.
        context?.invalidate()
    }

    private func finish(_ status: Int32) -> Never {
        if !stopping { tearDown() }
        // Once teardown and any callback are complete, a new signal must
        // terminate rather than be ignored between the final check and exit.
        var mask = sigset_t()
        sigemptyset(&mask)
        for number in interruptionSignals {
            signal(number, SIG_DFL)
            sigaddset(&mask, number)
        }
        pthread_sigmask(SIG_UNBLOCK, &mask, nil)
        // Only process exit releases the lock; never remove the file.
        _exit(interrupted() || !parentsAlive() ? 1 : status)
    }
}

let env = ProcessInfo.processInfo.environment
if env["DEV_SECRET_TOUCHID_CHECK_ONLY"] == "check" { _exit(preflight(LAContext())) }
MainActor.assumeIsolated {
    let request = TouchIDRequest(caller: pid_t(env["DEV_SECRET_TOUCHID_CALLER"] ?? "") ?? 0,
                                 reason: env["DEV_SECRET_TOUCHID_REASON"] ?? "",
                                 hasDetails: env["DEV_SECRET_TOUCHID_DETAILS"] == "1")
    request.run()
}
SWIFT
}

# Explain a touchid_authenticate return code of 2 or more.
touchid_problem() {
	case "$1" in
	2) printf 'not available (no sensor, or no fingerprints enrolled)' ;;
	3) printf 'locked after too many failed attempts; enter your Mac password once (for example, lock and unlock the screen) to re-enable it' ;;
	4) printf 'unlock needs swift (xcode-select --install)' ;;
	*) printf 'check failed (code %s)' "$1" ;;
	esac
}

# Print "available" or the reason Touch ID cannot be used right now.
touchid_status() {
	local rc=0
	touchid_authenticate check || rc=$?
	if [[ $rc -eq 0 ]]; then
		printf 'available'
	else
		touchid_problem "$rc"
	fi
}

# --- Passing secrets to security(1) without a command line -------------------
#
# Arguments are visible to other processes (ps), so secrets are sent as commands
# on stdin to `security -i` instead. Two properties of `security -i` matter:
# - lines longer than SECURITY_I_MAX_LINE are split, and the first piece runs on
#   its own, without the trailing keychain argument;
# - a write naming a keychain file that does not exist goes to the default
#   (login) keychain.

SECURITY_I_MAX_LINE=4000

# Quote one argument for a `security -i` command line.
security_i_quote() {
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//\"/\\\"}"
	printf '"%s"' "$s"
}

# Succeeds if LINE can be sent to `security -i` as a single command.
security_stdin_fits() {
	local line="$1"
	local LC_ALL=C # count bytes, not characters
	[[ "$line" != *[$'\n\r']* ]] && ((${#line} < SECURITY_I_MAX_LINE))
}

# Store VALUE as a generic password in KEYCHAIN. The value is hex-encoded (-X),
# so it can never break out of its argument.
keychain_write() {
	local keychain="$1" account="$2" service="$3" value="$4"
	local flag hex line

	[[ -f "$keychain" ]] || die "Keychain not found: $keychain"

	# Changing an existing item's access list (-U with -A) needs GUI approval and
	# fails in a terminal, so -A is set on creation only; updates keep the ACL.
	# -A lets the security CLI read the item without an authorization dialog.
	if security find-generic-password -a "$account" -s "$service" "$keychain" >/dev/null 2>&1; then
		flag="-U"
	else
		flag="-A"
	fi

	hex="$(printf '%s' "$value" | xxd -p | tr -d '\n')"
	line="add-generic-password $flag -a $(security_i_quote "$account") -s $(security_i_quote "$service")"
	line="$line -D \"application password\" -X $hex $(security_i_quote "$keychain")"

	if security_stdin_fits "$line"; then
		printf '%s\n' "$line" | security -i >/dev/null || return 1
	else
		info "Warning: $account is too long to send on stdin; its value is briefly visible in the process list while it is stored."
		security add-generic-password "$flag" -a "$account" -s "$service" \
			-D "application password" -w "$value" "$keychain" >/dev/null || return 1
	fi

	# `security -i` reports some failures only on stderr: confirm the value
	# landed in this keychain.
	[[ "$(keychain_read "$keychain" "$account" "$service" | xxd -p | tr -d '\n')" == "$hex" ]]
}

# Unlock KEYCHAIN with PASSWORD.
keychain_unlock() {
	local keychain="$1" password="$2"
	local line

	[[ -f "$keychain" ]] || return 1
	line="unlock-keychain -p $(security_i_quote "$password") $(security_i_quote "$keychain")"
	if security_stdin_fits "$line"; then
		printf '%s\n' "$line" | security -i >/dev/null
	else
		info "Warning: keychain password cannot be sent on stdin; it is briefly visible in the process list."
		security unlock-keychain -p "$password" "$keychain"
	fi
}

biometric_store() {
	keychain_write "$LOGIN_KEYCHAIN" "$ENROLL_ACCOUNT" "$ENROLL_SERVICE" "$1"
}

biometric_delete() {
	security delete-generic-password \
		-a "$ENROLL_ACCOUNT" \
		-s "$ENROLL_SERVICE" \
		"$LOGIN_KEYCHAIN" >/dev/null 2>&1 || true
}

# Name the program that started dev-secret: the nearest ancestor process that
# is not a shell, or nothing if there is none. For a program inside an app
# bundle, the app's name. Processes choose their own names, so this tells the
# user who is asking; it proves nothing.
requester_name() {
	local pid="$PPID" depth=0 line comm

	while ((depth < 10)); do
		depth=$((depth + 1))
		[[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)) || return 0
		line="$(ps -o ppid=,comm= -p "$pid" 2>/dev/null)" || return 0
		[[ "$line" =~ ^[[:space:]]*([0-9]+)[[:space:]]+(.+)$ ]] || return 0
		pid="${BASH_REMATCH[1]}"
		comm="${BASH_REMATCH[2]#-}" # login shells are named -zsh

		if [[ "$comm" == *.app/* ]]; then
			comm="${comm%%.app/*}"
		fi
		comm="${comm##*/}"

		case "$comm" in
		sh | bash | zsh | dash | fish | ksh | tcsh | csh) ;;
		*)
			printf '%s' "$comm"
			return 0
			;;
		esac
	done
}

# List secret names for the Touch ID prompt: "A, B, C".
describe_names() {
	local IFS=' ' names
	names="$*"
	printf '%s' "${names// /, }"
}

# Quote a command line for the Touch ID prompt, on one line and shortened to
# fit the dialog.
describe_command() {
	local IFS=' ' cmd
	cmd="$*"
	cmd="${cmd//[$'\n\r\t']/ }"
	((${#cmd} <= 40)) || cmd="${cmd:0:37}..."
	printf '"%s"' "$cmd"
}

# Unlock the keychain. ACTION says what happens next, as in
# "read GITHUB_TOKEN with dev-secret". With Touch ID, the prompt and stderr show
# it with the program that asked, so whoever approves knows what they approve.
ensure_unlocked() {
	local action="$1"
	shift

	if [[ ! -f "$BIOMETRIC_FLAG" ]]; then
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
		return
	fi

	local requester reason
	requester="$(requester_name)"
	reason="${requester:+let $requester }$action"
	info "Touch ID: $reason"

	local rc=0
	if (($#)); then
		touchid_authenticate prompt "$reason" "$requester" "$@" || rc=$?
	else
		touchid_authenticate prompt "$reason" || rc=$?
	fi

	case "$rc" in
	0) ;;
	2 | 3 | 4)
		info "Touch ID $(touchid_problem "$rc"). Falling back to the keychain password."
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
		return
		;;
	5) die "Touch ID coordination failed." ;;
	*) die "Touch ID authentication failed or was cancelled." ;;
	esac

	local pass
	if pass="$(keychain_read "$LOGIN_KEYCHAIN" "$ENROLL_ACCOUNT" "$ENROLL_SERVICE")"; then
		keychain_unlock "$KEYCHAIN_PATH" "$pass" || die "Keychain unlock failed."
		unset pass
	else
		info "Biometric credential not found in login keychain. Re-enroll: $APP_NAME keychain biometric enable"
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
	fi
}

create_keychain() {
	if keychain_exists; then
		info "Keychain exists: $KEYCHAIN_PATH"
		return 0
	fi

	mkdir -p "$(dirname "$KEYCHAIN_PATH")"
	info "Creating dedicated keychain: $KEYCHAIN_PATH"
	info "macOS will prompt you for the new keychain password."

	security create-keychain -P "$KEYCHAIN_PATH"
	security set-keychain-settings -lut 3600 "$KEYCHAIN_PATH" || true
}

add_keychain_to_search_list() {
	local current=()
	local line

	# Output lines look like:     "/Users/me/Library/Keychains/login.keychain-db"
	while IFS= read -r line; do
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line#\"}"
		line="${line%\"}"
		[[ -n "$line" && "$line" != "$KEYCHAIN_PATH" ]] && current+=("$line")
	done < <(security list-keychains -d user 2>/dev/null || true)

	# ${arr[@]+...} keeps an empty array from tripping `set -u` on bash 3.2.
	security list-keychains -d user -s "$KEYCHAIN_PATH" ${current[@]+"${current[@]}"}
}

cmd_init() {
	local defaults_src=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--defaults)
			shift
			defaults_src="${1:-}"
			[[ -n "$defaults_src" ]] || die "--defaults requires a file path."
			;;
		*)
			die "Unknown init option: $1"
			;;
		esac
		shift || true
	done

	require_macos_security
	ensure_config_dir
	create_keychain
	add_keychain_to_search_list || true

	if [[ -n "$defaults_src" ]]; then
		[[ -f "$defaults_src" ]] || die "Defaults file not found: $defaults_src"
		cp "$defaults_src" "$DEFAULTS_FILE"
		chmod 600 "$DEFAULTS_FILE" 2>/dev/null || true
		say "Installed defaults file: $DEFAULTS_FILE"
	elif [[ ! -f "$DEFAULTS_FILE" ]]; then
		cat >"$DEFAULTS_FILE" <<'DEFAULTS'
# One secret name per line. Edit this file to customize setup prompts.
GITHUB_TOKEN
DEFAULTS
		chmod 600 "$DEFAULTS_FILE" 2>/dev/null || true
		say "Created defaults file: $DEFAULTS_FILE"
	fi

	say "Initialized $APP_NAME."
	say "Keychain: $KEYCHAIN_PATH"

	if command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; then
		if [[ ! -f "$BIOMETRIC_FLAG" ]]; then
			local reply
			read -r -p "Enroll Touch ID for keychain unlock? [Y/n] " reply || true
			case "${reply:-Y}" in
			y | Y | yes | YES | "") cmd_keychain_biometric_enable ;;
			esac
		fi
	fi
}

cmd_keychain_biometric_enable() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	{ command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; } || die "Touch ID not available or not enrolled on this device."

	local pass
	read -r -s -p "Keychain password: " pass
	printf '\n' >&2
	[[ -n "$pass" ]] || die "Empty password."

	keychain_unlock "$KEYCHAIN_PATH" "$pass" 2>/dev/null || die "Wrong keychain password."

	biometric_store "$pass" || die "Failed to store biometric credential."
	unset pass

	ensure_config_dir
	touch "$BIOMETRIC_FLAG"
	chmod 600 "$BIOMETRIC_FLAG" 2>/dev/null || true

	say "Biometric unlock enabled."
}

cmd_keychain_biometric_disable() {
	require_macos_security
	[[ -f "$BIOMETRIC_FLAG" ]] || die "Biometric unlock is not enabled."
	biometric_delete || true
	rm -f "$BIOMETRIC_FLAG"
	say "Biometric unlock disabled."
}

cmd_keychain_biometric_status() {
	say "Touch ID: $(touchid_status)"
	if [[ -f "$BIOMETRIC_FLAG" ]]; then
		say "Enabled:   yes"
	else
		say "Enabled:   no"
	fi
}

cmd_keychain_biometric() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
	enable) cmd_keychain_biometric_enable "$@" ;;
	disable) cmd_keychain_biometric_disable "$@" ;;
	status) cmd_keychain_biometric_status "$@" ;;
	*) die "Unknown biometric subcommand '${sub}'. Use: enable, disable, status" ;;
	esac
}

cmd_keychain_lock() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	security lock-keychain "$KEYCHAIN_PATH" 2>/dev/null || true
	say "Keychain locked."
}

cmd_keychain_unlock() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "unlock the $KEYCHAIN_NAME keychain"
	say "Keychain unlocked."
}

cmd_keychain_status() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "show the $KEYCHAIN_NAME keychain status"
	say "Keychain: $KEYCHAIN_PATH"
	security show-keychain-info "$KEYCHAIN_PATH" 2>/dev/null || true
	say "Touch ID: $(touchid_status)"
}

cmd_keychain() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
	biometric) cmd_keychain_biometric "$@" ;;
	lock) cmd_keychain_lock "$@" ;;
	unlock) cmd_keychain_unlock "$@" ;;
	status) cmd_keychain_status "$@" ;;
	*) die "Unknown keychain subcommand '${sub}'. Use: biometric, lock, unlock, status" ;;
	esac
}

read_hidden_secret() {
	local name="$1"
	local value1 value2

	while true; do
		read -r -s -p "Enter value for $name: " value1 || true
		printf '\n' >&2

		[[ -n "$value1" ]] || die "Empty secret aborted."

		read -r -s -p "Confirm value for $name: " value2 || true
		printf '\n' >&2

		if [[ "$value1" == "$value2" ]]; then
			printf '%s' "$value1"
			return 0
		fi

		info "Values did not match. Try again."
	done
}

store_secret() {
	keychain_write "$KEYCHAIN_PATH" "$1" "$(service_name_for "$1")" "$2"
}

cmd_set() {
	require_macos_security

	local name="${1:-}"
	require_secret_name "$name"
	shift || true

	local mode="prompt"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--stdin) mode="stdin" ;;
		*) die "Unknown set option: $1" ;;
		esac
		shift
	done

	keychain_exists || cmd_init >/dev/null
	ensure_unlocked "store $name in $APP_NAME"

	local value
	if [[ "$mode" == "stdin" ]]; then
		[[ ! -t 0 ]] || die "--stdin requires piped input."
		# Drop trailing line endings: `echo "$TOKEN" | dev-secret set ...` must not
		# store the newline as part of the secret.
		value="$(cat)"
		while [[ "$value" == *[$'\r\n'] ]]; do
			value="${value%?}"
		done
		[[ -n "$value" ]] || die "Empty secret aborted."
	else
		value="$(read_hidden_secret "$name")"
	fi

	store_secret "$name" "$value"
	unset value
	say "Stored $name."
}

# Print a secret's exact bytes. `-w` prints any value it deems non-printable
# (newline, tab, non-ASCII UTF-8, ...) as bare hex that cannot be told
# apart from a printable value, so read with -g, which marks that form with 0x:
#   password: "printable value"
#   password: 0x6361660A  "caf\012"
keychain_read() {
	local keychain="$1" account="$2" service="$3"
	local out line

	out="$(security find-generic-password \
		-a "$account" \
		-s "$service" \
		-g \
		"$keychain" 2>&1 >/dev/null)" || return 1

	# Pure expansions only: here-strings and here-docs would write the secret to
	# a temp file on bash 3.2.
	case "$out" in
	'password: '*) line="${out%%$'\n'*}" ;;
	*$'\n''password: '*)
		line="${out#*$'\n'password: }"
		line="password: ${line%%$'\n'*}"
		;;
	*) return 1 ;;
	esac

	case "$line" in
	'password: 0x'*)
		line="${line#password: 0x}"
		printf '%s' "${line%%[!0-9A-Fa-f]*}" | xxd -r -p
		;;
	'password: "'*'"')
		line="${line#password: \"}"
		printf '%s' "${line%\"}"
		;;
	*) return 1 ;;
	esac
}

get_secret() {
	keychain_read "$KEYCHAIN_PATH" "$1" "$(service_name_for "$1")"
}

cmd_get() {
	require_macos_security
	local name="${1:-}"
	require_secret_name "$name"
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "read $name with $APP_NAME"

	local value
	value="$(get_secret "$name")" || die "Secret not found: $name"
	printf '%s\n' "$value"
}

cmd_run() {
	require_macos_security

	[[ $# -gt 0 ]] || die "Usage: $APP_NAME run NAME [NAME ...] -- command [args...]"

	local names=()
	while [[ $# -gt 0 ]]; do
		if [[ "$1" == "--" ]]; then
			shift
			break
		fi
		require_secret_name "$1"
		names+=("$1")
		shift
	done

	[[ ${#names[@]} -gt 0 ]] || die "At least one secret name is required."
	[[ $# -gt 0 ]] || die "Command missing after --."

	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "run $(describe_command "$@") with $(describe_names "${names[@]}") from $APP_NAME" \
		"${#names[@]}" "${names[@]}" "$@"

	local name value

	# `export` is a builtin, so values reach the command through its environment
	# only, never through a command line (`env NAME=value cmd` would show in ps).
	for name in "${names[@]}"; do
		value="$(get_secret "$name")" || die "Secret not found: $name"
		export "$name=$value"
	done
	unset value

	exec "$@"
}

cmd_list() {
	require_macos_security
	keychain_exists || die "Keychain not found: $KEYCHAIN_PATH"
	ensure_unlocked "list the secret names in $APP_NAME"

	security dump-keychain "$KEYCHAIN_PATH" 2>/dev/null |
		awk -F'=' '/"acct"<blob>=/ {gsub(/^[[:space:]]*"|"$/, "", $2); print $2}' |
		sort -u
}

cmd_delete() {
	require_macos_security
	local name="${1:-}"
	require_secret_name "$name"
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "delete $name from $APP_NAME"

	security delete-generic-password \
		-a "$name" \
		-s "$(service_name_for "$name")" \
		"$KEYCHAIN_PATH" >/dev/null ||
		die "Secret not found: $name"

	say "Deleted $name."
}

cmd_doctor() {
	local ok=0

	say "$APP_NAME doctor"

	if [[ "${OSTYPE:-}" == darwin* ]]; then say "OK macOS detected"; else
		say "FAIL not macOS"
		ok=1
	fi
	if command -v security >/dev/null 2>&1; then say "OK security command available"; else
		say "FAIL security command missing"
		ok=1
	fi
	if command -v awk >/dev/null 2>&1; then say "OK awk available"; else
		say "FAIL awk missing"
		ok=1
	fi
	if command -v xxd >/dev/null 2>&1; then say "OK xxd available"; else
		say "FAIL xxd missing"
		ok=1
	fi
	if [[ -d "$CONFIG_DIR" ]]; then say "OK config dir: $CONFIG_DIR"; else say "WARN config dir missing: $CONFIG_DIR"; fi

	if command -v security >/dev/null 2>&1; then
		if keychain_exists; then say "OK keychain: $KEYCHAIN_PATH"; else say "WARN keychain missing: $KEYCHAIN_PATH"; fi
	fi

	local touchid
	touchid="$(touchid_status)"
	if [[ "$touchid" == "available" ]]; then
		say "OK Touch ID available"
	elif [[ -f "$BIOMETRIC_FLAG" ]]; then
		say "WARN Touch ID $touchid (Touch ID unlock is enabled; the keychain password will be asked instead)"
	else
		say "INFO Touch ID $touchid"
	fi

	return "$ok"
}

is_dynamic_assignment_line() {
	local line="$1"

	[[ "$line" =~ =.*\$\(.+\) ]] && return 0
	[[ "$line" =~ =.*\`.+\` ]] && return 0

	return 1
}

scan_dynamic_line() {
	local line="$1"

	[[ "$line" =~ ^[[:space:]]*# ]] && return 1
	[[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)[A-Za-z0-9_]*)=.+$ ]] || return 1

	is_dynamic_assignment_line "$line"
}

scan_candidate_line() {
	local line="$1"
	[[ "$line" =~ ^[[:space:]]*# ]] && return 1
	[[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)[A-Za-z0-9_]*)=.+$ ]]
}

scan_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0

	local n=0
	local line name kind

	while IFS= read -r line || [[ -n "$line" ]]; do
		n=$((n + 1))

		if scan_candidate_line "$line"; then
			name="${BASH_REMATCH[2]}"

			if is_dynamic_assignment_line "$line"; then
				kind="dynamic"
			else
				kind="plaintext"
			fi

			printf '%s:%s:%s:%s\n' "$file" "$n" "$name" "$kind"
		fi
	done <"$file"
}

cmd_scan_env() {
	local files=("$@")
	[[ ${#files[@]} -gt 0 ]] || files=("${SCAN_FILES[@]}")

	local found=0
	local file line name kind

	for file in "${files[@]}"; do
		while IFS=: read -r file line name kind; do
			[[ -n "${file:-}" ]] || continue
			found=1

			if [[ "$kind" == "dynamic" ]]; then
				say "$file:$line:$name:dynamic command substitution detected; skipped by import-env"
			else
				say "$file:$line:$name:plaintext"
			fi
		done < <(scan_file "$file")
	done

	if [[ "$found" -eq 0 ]]; then
		say "No plaintext env secrets found."
	fi
}

extract_assignment_value() {
	local line="$1"

	line="${line#export }"

	local value="${line#*=}"
	# Trailing whitespace (including a CR from CRLF files) is never part of the value.
	value="${value%"${value##*[![:space:]]}"}"

	# As in the shell, a comment starts at a `#` preceded by whitespace, but only
	# outside quotes, so quoted secrets may contain " #".
	local dq_comment='^"([^"]*)"[[:space:]]+#'
	local sq_comment="^'([^']*)'[[:space:]]+#"
	if [[ "$value" =~ $dq_comment || "$value" =~ $sq_comment ]]; then
		value="${BASH_REMATCH[1]}"
	elif [[ "$value" =~ ^\"(.*)\"$ ]]; then
		value="${BASH_REMATCH[1]}"
	elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
		value="${BASH_REMATCH[1]}"
	else
		value="${value%%[[:space:]]#*}"
		value="${value%"${value##*[![:space:]]}"}"
	fi

	printf '%s' "$value"
}

rewrite_imported_file() {
	local file="$1"
	local tmp="$2"
	local line name value

	while IFS= read -r line || [[ -n "$line" ]]; do
		if scan_candidate_line "$line"; then
			name="${BASH_REMATCH[2]}"

			if is_dynamic_assignment_line "$line"; then
				printf '%s\n' "$line" >>"$tmp"
				continue
			fi

			value="$(extract_assignment_value "$line")"

			if [[ -n "$value" ]]; then
				store_secret "$name" "$value"
				printf '# dev-secret imported %s and removed plaintext value\n' "$name" >>"$tmp"
				unset value
				continue
			fi
		fi

		printf '%s\n' "$line" >>"$tmp"
	done <"$file"
}

cmd_import_env() {
	require_macos_security

	local assume_yes="false"
	local files=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--yes | -y) assume_yes="true" ;;
		*) files+=("$1") ;;
		esac
		shift
	done

	[[ ${#files[@]} -gt 0 ]] || files=("${SCAN_FILES[@]}")

	keychain_exists || cmd_init >/dev/null

	local matches plaintext_matches dynamic_matches
	matches="$(for f in "${files[@]}"; do scan_file "$f"; done || true)"

	if [[ -z "$matches" ]]; then
		say "No plaintext env secrets found."
		return 0
	fi

	plaintext_matches="$(printf '%s\n' "$matches" | awk -F: '$4 == "plaintext"')"
	dynamic_matches="$(printf '%s\n' "$matches" | awk -F: '$4 == "dynamic"')"

	if [[ -n "$dynamic_matches" ]]; then
		say "Skipped dynamic env assignments:"
		printf '%s\n' "$dynamic_matches" | while IFS=: read -r file line name kind; do
			say "- $name in $file:$line uses command substitution"
		done

		say ""
		say "Import those manually after resolving the value, for example:"
		say "  gh auth token | dev-secret set NODE_AUTH_TOKEN --stdin"
		say ""
	fi

	if [[ -z "$plaintext_matches" ]]; then
		say "No plaintext env secrets to import."
		return 0
	fi

	say "Found plaintext secrets to import:"
	printf '%s\n' "$plaintext_matches" | while IFS=: read -r file line name kind; do
		say "- $name in $file:$line"
	done

	if [[ "$assume_yes" != "true" ]]; then
		local reply
		read -r -p "Import these values into Keychain and remove plaintext from files? [y/N] " reply || true
		case "$reply" in
		y | Y | yes | YES) ;;
		*) die "Aborted." ;;
		esac
	fi

	# Unlock only now, so the prompt can name the secrets just confirmed.
	ensure_unlocked "import $(printf '%s\n' "$plaintext_matches" |
		awk -F: '!seen[$(NF - 1)]++ { printf "%s%s", (n++ ? ", " : ""), $(NF - 1) }') into $APP_NAME"

	local file backup tmp timestamp
	timestamp="$(date +%Y%m%d-%H%M%S)"

	for file in "${files[@]}"; do
		[[ -f "$file" ]] || continue

		if scan_file "$file" | awk -F: '$4 == "plaintext" { found=1 } END { exit !found }'; then
			backup="${file}.bak.dev-secret.${timestamp}"
			tmp="${file}.tmp.dev-secret.${timestamp}"

			cp "$file" "$backup"
			chmod 600 "$backup" 2>/dev/null || true
			(
				umask 177
				: >"$tmp"
			)
			rewrite_imported_file "$file" "$tmp"
			mv "$tmp" "$file"

			say "Imported and cleaned: $file"
			say "Backup: $backup (delete once you have verified the migration)"
		fi
	done
}

main() {
	local cmd="${1:-help}"
	shift || true

	case "$cmd" in
	init) cmd_init "$@" ;;
	set) cmd_set "$@" ;;
	get) cmd_get "$@" ;;
	run) cmd_run "$@" ;;
	list | ls) cmd_list "$@" ;;
	delete | rm) cmd_delete "$@" ;;
	keychain) cmd_keychain "$@" ;;
	doctor) cmd_doctor "$@" ;;
	scan-env) cmd_scan_env "$@" ;;
	import-env) cmd_import_env "$@" ;;
	help | -h | --help) usage ;;
	version | --version) say "$VERSION" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
}

# Run only when executed, so tests can source this file to exercise functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
