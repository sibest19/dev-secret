#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

VERSION="0.4.0"
APP_NAME="dev-secret"
KEYCHAIN_NAME="${DEV_SECRET_KEYCHAIN_NAME:-dev-secrets}"
KEYCHAIN_PATH="${DEV_SECRET_KEYCHAIN_PATH:-$HOME/Library/Keychains/${KEYCHAIN_NAME}.keychain-db}"
CONFIG_DIR="${DEV_SECRET_CONFIG_DIR:-$HOME/.config/dev-secret}"
DEFAULTS_FILE="${DEV_SECRET_DEFAULTS_FILE:-$CONFIG_DIR/defaults}"
SERVICE_PREFIX="${DEV_SECRET_SERVICE_PREFIX:-it.simoneandreani.dev-secret}"
SCAN_FILES=("$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.zshenv" "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc")
LOGIN_KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
ENROLL_SERVICE="${SERVICE_PREFIX}.keychain-unlock"
ENROLL_ACCOUNT="keychain-password"
BIOMETRIC_FLAG="$CONFIG_DIR/.biometric-enabled"

say() { printf '%s\n' "$*"; }
info() { printf '%s\n' "$*" >&2; }
die() {
	printf 'Error: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<USAGE
$APP_NAME $VERSION

Usage:
  $APP_NAME init [--defaults FILE]
  $APP_NAME set NAME [--stdin]
  $APP_NAME get NAME
  $APP_NAME run NAME [NAME ...] -- command [args...]
  $APP_NAME list
  $APP_NAME delete NAME
  $APP_NAME keychain biometric enable|disable|status
  $APP_NAME keychain lock|unlock|status
  $APP_NAME doctor
  $APP_NAME scan-env [FILE ...]
  $APP_NAME import-env [--yes] [FILE ...]
  $APP_NAME help
  $APP_NAME version
USAGE
}

require_macos_security() {
	[[ "${OSTYPE:-}" == darwin* ]] || die "$APP_NAME requires macOS because it uses the native Keychain."
	command -v security >/dev/null 2>&1 || die "macOS security command not found."
}

service_name_for() {
	printf '%s.%s' "$SERVICE_PREFIX" "$1"
}

valid_secret_name() {
	[[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

require_secret_name() {
	local name="${1:-}"
	[[ -n "$name" ]] || die "Missing secret name."
	valid_secret_name "$name" || die "Invalid secret name '$name'. Use ENV_VAR style names."
}

ensure_config_dir() {
	mkdir -p "$CONFIG_DIR"
	chmod 700 "$CONFIG_DIR" 2>/dev/null || true
}

keychain_exists() {
	[[ -f "$KEYCHAIN_PATH" ]]
}

# Touch ID via LocalAuthentication.
#   touchid_authenticate check          only test whether biometrics can be used
#                                       right now; this never shows a prompt
#   touchid_authenticate prompt REASON  ask for Touch ID; macOS shows
#                                       "<app> is trying to REASON."
# Returns: 0 authenticated (or usable), 1 failed or cancelled,
#          2 no usable biometrics, 3 locked out, 4 swift not installed.
touchid_authenticate() {
	local mode="${1:-}" reason="${2:-}"
	command -v swift >/dev/null 2>&1 || return 4
	# The reason reaches Swift through the environment, never its source code.
	DEV_SECRET_TOUCHID_CHECK_ONLY="$mode" DEV_SECRET_TOUCHID_REASON="$reason" \
		swift - 2>/dev/null <<'SWIFT'
import Foundation
import LocalAuthentication
let ctx = LAContext()
var err: NSError?
guard ctx.canEvaluatePolicy(.deviceOwnerAuthenticationWithBiometrics, error: &err) else {
    exit(err?.code == LAError.Code.biometryLockout.rawValue ? 3 : 2)
}
let env = ProcessInfo.processInfo.environment
if env["DEV_SECRET_TOUCHID_CHECK_ONLY"] == "check" { exit(0) }
// An empty reason makes evaluatePolicy throw.
var reason = env["DEV_SECRET_TOUCHID_REASON"] ?? ""
if reason.isEmpty { reason = "unlock the dev-secrets keychain" }
let sem = DispatchSemaphore(value: 0)
var ok = false
ctx.evaluatePolicy(.deviceOwnerAuthenticationWithBiometrics,
                   localizedReason: reason) { s, _ in ok = s; sem.signal() }
sem.wait()
exit(ok ? 0 : 1)
SWIFT
}

# Explain a touchid_authenticate return code of 2 or more.
touchid_problem() {
	case "$1" in
	2) printf 'not available (no sensor, or no fingerprints enrolled)' ;;
	3) printf 'locked after too many failed attempts; enter your Mac password once (for example, lock and unlock the screen) to re-enable it' ;;
	4) printf 'unlock needs swift (xcode-select --install)' ;;
	*) printf 'check failed (code %s)' "$1" ;;
	esac
}

# Print "available" or the reason Touch ID cannot be used right now.
touchid_status() {
	local rc=0
	touchid_authenticate check || rc=$?
	if [[ $rc -eq 0 ]]; then
		printf 'available'
	else
		touchid_problem "$rc"
	fi
}

# --- Passing secrets to security(1) without a command line -------------------
#
# Arguments are visible to other processes (ps), so secrets are sent as commands
# on stdin to `security -i` instead. Two properties of `security -i` matter:
# - lines longer than SECURITY_I_MAX_LINE are split, and the first piece runs on
#   its own, without the trailing keychain argument;
# - a write naming a keychain file that does not exist goes to the default
#   (login) keychain.

SECURITY_I_MAX_LINE=4000

# Quote one argument for a `security -i` command line.
security_i_quote() {
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//\"/\\\"}"
	printf '"%s"' "$s"
}

# Succeeds if LINE can be sent to `security -i` as a single command.
security_stdin_fits() {
	local line="$1"
	local LC_ALL=C # count bytes, not characters
	[[ "$line" != *[$'\n\r']* ]] && ((${#line} < SECURITY_I_MAX_LINE))
}

# Store VALUE as a generic password in KEYCHAIN. The value is hex-encoded (-X),
# so it can never break out of its argument.
keychain_write() {
	local keychain="$1" account="$2" service="$3" value="$4"
	local flag hex line

	[[ -f "$keychain" ]] || die "Keychain not found: $keychain"

	# Changing an existing item's access list (-U with -A) needs GUI approval and
	# fails in a terminal, so -A is set on creation only; updates keep the ACL.
	# -A lets the security CLI read the item without an authorization dialog.
	if security find-generic-password -a "$account" -s "$service" "$keychain" >/dev/null 2>&1; then
		flag="-U"
	else
		flag="-A"
	fi

	hex="$(printf '%s' "$value" | xxd -p | tr -d '\n')"
	line="add-generic-password $flag -a $(security_i_quote "$account") -s $(security_i_quote "$service")"
	line="$line -D \"application password\" -X $hex $(security_i_quote "$keychain")"

	if security_stdin_fits "$line"; then
		printf '%s\n' "$line" | security -i >/dev/null || return 1
	else
		info "Warning: $account is too long to send on stdin; its value is briefly visible in the process list while it is stored."
		security add-generic-password "$flag" -a "$account" -s "$service" \
			-D "application password" -w "$value" "$keychain" >/dev/null || return 1
	fi

	# `security -i` reports some failures only on stderr: confirm the value
	# landed in this keychain.
	[[ "$(keychain_read "$keychain" "$account" "$service" | xxd -p | tr -d '\n')" == "$hex" ]]
}

# Unlock KEYCHAIN with PASSWORD.
keychain_unlock() {
	local keychain="$1" password="$2"
	local line

	[[ -f "$keychain" ]] || return 1
	line="unlock-keychain -p $(security_i_quote "$password") $(security_i_quote "$keychain")"
	if security_stdin_fits "$line"; then
		printf '%s\n' "$line" | security -i >/dev/null
	else
		info "Warning: keychain password cannot be sent on stdin; it is briefly visible in the process list."
		security unlock-keychain -p "$password" "$keychain"
	fi
}

biometric_store() {
	keychain_write "$LOGIN_KEYCHAIN" "$ENROLL_ACCOUNT" "$ENROLL_SERVICE" "$1"
}

biometric_delete() {
	security delete-generic-password \
		-a "$ENROLL_ACCOUNT" \
		-s "$ENROLL_SERVICE" \
		"$LOGIN_KEYCHAIN" >/dev/null 2>&1 || true
}

# Name the program that started dev-secret: the nearest ancestor process that
# is not a shell, or nothing if there is none. For a program inside an app
# bundle, the app's name. Processes choose their own names, so this tells the
# user who is asking; it proves nothing.
requester_name() {
	local pid="$PPID" depth=0 line comm

	while ((depth < 10)); do
		depth=$((depth + 1))
		[[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)) || return 0
		line="$(ps -o ppid=,comm= -p "$pid" 2>/dev/null)" || return 0
		[[ "$line" =~ ^[[:space:]]*([0-9]+)[[:space:]]+(.+)$ ]] || return 0
		pid="${BASH_REMATCH[1]}"
		comm="${BASH_REMATCH[2]#-}" # login shells are named -zsh

		if [[ "$comm" == *.app/* ]]; then
			comm="${comm%%.app/*}"
		fi
		comm="${comm##*/}"

		case "$comm" in
		sh | bash | zsh | dash | fish | ksh | tcsh | csh) ;;
		*)
			printf '%s' "$comm"
			return 0
			;;
		esac
	done
}

# List secret names for the Touch ID prompt: "A, B, C".
describe_names() {
	local IFS=' ' names
	names="$*"
	printf '%s' "${names// /, }"
}

# Quote a command line for the Touch ID prompt, on one line and shortened to
# fit the dialog.
describe_command() {
	local IFS=' ' cmd
	cmd="$*"
	cmd="${cmd//[$'\n\r\t']/ }"
	((${#cmd} <= 40)) || cmd="${cmd:0:37}..."
	printf '"%s"' "$cmd"
}

# Unlock the keychain. ACTION says what happens next, as in
# "read GITHUB_TOKEN with dev-secret". With Touch ID, the prompt and stderr show
# it with the program that asked, so whoever approves knows what they approve.
ensure_unlocked() {
	local action="$1"

	if [[ ! -f "$BIOMETRIC_FLAG" ]]; then
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
		return
	fi

	local requester reason
	requester="$(requester_name)"
	reason="${requester:+let $requester }$action"
	info "Touch ID: $reason"

	local rc=0
	touchid_authenticate prompt "$reason" || rc=$?

	if [[ $rc -ge 2 ]]; then
		info "Touch ID $(touchid_problem "$rc"). Falling back to the keychain password."
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
		return
	fi

	[[ $rc -eq 0 ]] || die "Touch ID authentication failed or was cancelled."

	local pass
	if pass="$(keychain_read "$LOGIN_KEYCHAIN" "$ENROLL_ACCOUNT" "$ENROLL_SERVICE")"; then
		keychain_unlock "$KEYCHAIN_PATH" "$pass" || die "Keychain unlock failed."
		unset pass
	else
		info "Biometric credential not found in login keychain. Re-enroll: $APP_NAME keychain biometric enable"
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
	fi
}

create_keychain() {
	if keychain_exists; then
		info "Keychain exists: $KEYCHAIN_PATH"
		return 0
	fi

	mkdir -p "$(dirname "$KEYCHAIN_PATH")"
	info "Creating dedicated keychain: $KEYCHAIN_PATH"
	info "macOS will prompt you for the new keychain password."

	security create-keychain -P "$KEYCHAIN_PATH"
	security set-keychain-settings -lut 3600 "$KEYCHAIN_PATH" || true
}

add_keychain_to_search_list() {
	local current=()
	local line

	# Output lines look like:     "/Users/me/Library/Keychains/login.keychain-db"
	while IFS= read -r line; do
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line#\"}"
		line="${line%\"}"
		[[ -n "$line" && "$line" != "$KEYCHAIN_PATH" ]] && current+=("$line")
	done < <(security list-keychains -d user 2>/dev/null || true)

	# ${arr[@]+...} keeps an empty array from tripping `set -u` on bash 3.2.
	security list-keychains -d user -s "$KEYCHAIN_PATH" ${current[@]+"${current[@]}"}
}

cmd_init() {
	local defaults_src=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--defaults)
			shift
			defaults_src="${1:-}"
			[[ -n "$defaults_src" ]] || die "--defaults requires a file path."
			;;
		*)
			die "Unknown init option: $1"
			;;
		esac
		shift || true
	done

	require_macos_security
	ensure_config_dir
	create_keychain
	add_keychain_to_search_list || true

	if [[ -n "$defaults_src" ]]; then
		[[ -f "$defaults_src" ]] || die "Defaults file not found: $defaults_src"
		cp "$defaults_src" "$DEFAULTS_FILE"
		chmod 600 "$DEFAULTS_FILE" 2>/dev/null || true
		say "Installed defaults file: $DEFAULTS_FILE"
	elif [[ ! -f "$DEFAULTS_FILE" ]]; then
		cat >"$DEFAULTS_FILE" <<'DEFAULTS'
# One secret name per line. Edit this file to customize setup prompts.
GITHUB_TOKEN
DEFAULTS
		chmod 600 "$DEFAULTS_FILE" 2>/dev/null || true
		say "Created defaults file: $DEFAULTS_FILE"
	fi

	say "Initialized $APP_NAME."
	say "Keychain: $KEYCHAIN_PATH"

	if command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; then
		if [[ ! -f "$BIOMETRIC_FLAG" ]]; then
			local reply
			read -r -p "Enroll Touch ID for keychain unlock? [Y/n] " reply || true
			case "${reply:-Y}" in
			y | Y | yes | YES | "") cmd_keychain_biometric_enable ;;
			esac
		fi
	fi
}

cmd_keychain_biometric_enable() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	{ command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; } || die "Touch ID not available or not enrolled on this device."

	local pass
	read -r -s -p "Keychain password: " pass
	printf '\n' >&2
	[[ -n "$pass" ]] || die "Empty password."

	keychain_unlock "$KEYCHAIN_PATH" "$pass" 2>/dev/null || die "Wrong keychain password."

	biometric_store "$pass" || die "Failed to store biometric credential."
	unset pass

	ensure_config_dir
	touch "$BIOMETRIC_FLAG"
	chmod 600 "$BIOMETRIC_FLAG" 2>/dev/null || true

	say "Biometric unlock enabled."
}

cmd_keychain_biometric_disable() {
	require_macos_security
	[[ -f "$BIOMETRIC_FLAG" ]] || die "Biometric unlock is not enabled."
	biometric_delete || true
	rm -f "$BIOMETRIC_FLAG"
	say "Biometric unlock disabled."
}

cmd_keychain_biometric_status() {
	say "Touch ID: $(touchid_status)"
	if [[ -f "$BIOMETRIC_FLAG" ]]; then
		say "Enabled:   yes"
	else
		say "Enabled:   no"
	fi
}

cmd_keychain_biometric() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
	enable) cmd_keychain_biometric_enable "$@" ;;
	disable) cmd_keychain_biometric_disable "$@" ;;
	status) cmd_keychain_biometric_status "$@" ;;
	*) die "Unknown biometric subcommand '${sub}'. Use: enable, disable, status" ;;
	esac
}

cmd_keychain_lock() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	security lock-keychain "$KEYCHAIN_PATH" 2>/dev/null || true
	say "Keychain locked."
}

cmd_keychain_unlock() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "unlock the $KEYCHAIN_NAME keychain"
	say "Keychain unlocked."
}

cmd_keychain_status() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "show the $KEYCHAIN_NAME keychain status"
	say "Keychain: $KEYCHAIN_PATH"
	security show-keychain-info "$KEYCHAIN_PATH" 2>/dev/null || true
	say "Touch ID: $(touchid_status)"
}

cmd_keychain() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
	biometric) cmd_keychain_biometric "$@" ;;
	lock) cmd_keychain_lock "$@" ;;
	unlock) cmd_keychain_unlock "$@" ;;
	status) cmd_keychain_status "$@" ;;
	*) die "Unknown keychain subcommand '${sub}'. Use: biometric, lock, unlock, status" ;;
	esac
}

read_hidden_secret() {
	local name="$1"
	local value1 value2

	while true; do
		read -r -s -p "Enter value for $name: " value1 || true
		printf '\n' >&2

		[[ -n "$value1" ]] || die "Empty secret aborted."

		read -r -s -p "Confirm value for $name: " value2 || true
		printf '\n' >&2

		if [[ "$value1" == "$value2" ]]; then
			printf '%s' "$value1"
			return 0
		fi

		info "Values did not match. Try again."
	done
}

store_secret() {
	keychain_write "$KEYCHAIN_PATH" "$1" "$(service_name_for "$1")" "$2"
}

cmd_set() {
	require_macos_security

	local name="${1:-}"
	require_secret_name "$name"
	shift || true

	local mode="prompt"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--stdin) mode="stdin" ;;
		*) die "Unknown set option: $1" ;;
		esac
		shift
	done

	keychain_exists || cmd_init >/dev/null
	ensure_unlocked "store $name in $APP_NAME"

	local value
	if [[ "$mode" == "stdin" ]]; then
		[[ ! -t 0 ]] || die "--stdin requires piped input."
		# Drop trailing line endings: `echo "$TOKEN" | dev-secret set ...` must not
		# store the newline as part of the secret.
		value="$(cat)"
		while [[ "$value" == *[$'\r\n'] ]]; do
			value="${value%?}"
		done
		[[ -n "$value" ]] || die "Empty secret aborted."
	else
		value="$(read_hidden_secret "$name")"
	fi

	store_secret "$name" "$value"
	unset value
	say "Stored $name."
}

# Print a secret's exact bytes. `-w` prints any value it deems non-printable
# (newline, tab, non-ASCII UTF-8, ...) as bare hex that cannot be told
# apart from a printable value, so read with -g, which marks that form with 0x:
#   password: "printable value"
#   password: 0x6361660A  "caf\012"
keychain_read() {
	local keychain="$1" account="$2" service="$3"
	local out line

	out="$(security find-generic-password \
		-a "$account" \
		-s "$service" \
		-g \
		"$keychain" 2>&1 >/dev/null)" || return 1

	# Pure expansions only: here-strings and here-docs would write the secret to
	# a temp file on bash 3.2.
	case "$out" in
	'password: '*) line="${out%%$'\n'*}" ;;
	*$'\n''password: '*)
		line="${out#*$'\n'password: }"
		line="password: ${line%%$'\n'*}"
		;;
	*) return 1 ;;
	esac

	case "$line" in
	'password: 0x'*)
		line="${line#password: 0x}"
		printf '%s' "${line%%[!0-9A-Fa-f]*}" | xxd -r -p
		;;
	'password: "'*'"')
		line="${line#password: \"}"
		printf '%s' "${line%\"}"
		;;
	*) return 1 ;;
	esac
}

get_secret() {
	keychain_read "$KEYCHAIN_PATH" "$1" "$(service_name_for "$1")"
}

cmd_get() {
	require_macos_security
	local name="${1:-}"
	require_secret_name "$name"
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "read $name with $APP_NAME"

	local value
	value="$(get_secret "$name")" || die "Secret not found: $name"
	printf '%s\n' "$value"
}

cmd_run() {
	require_macos_security

	[[ $# -gt 0 ]] || die "Usage: $APP_NAME run NAME [NAME ...] -- command [args...]"

	local names=()
	while [[ $# -gt 0 ]]; do
		if [[ "$1" == "--" ]]; then
			shift
			break
		fi
		require_secret_name "$1"
		names+=("$1")
		shift
	done

	[[ ${#names[@]} -gt 0 ]] || die "At least one secret name is required."
	[[ $# -gt 0 ]] || die "Command missing after --."

	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "run $(describe_command "$@") with $(describe_names "${names[@]}") from $APP_NAME"

	local name value

	# `export` is a builtin, so values reach the command through its environment
	# only, never through a command line (`env NAME=value cmd` would show in ps).
	for name in "${names[@]}"; do
		value="$(get_secret "$name")" || die "Secret not found: $name"
		export "$name=$value"
	done
	unset value

	exec "$@"
}

cmd_list() {
	require_macos_security
	keychain_exists || die "Keychain not found: $KEYCHAIN_PATH"
	ensure_unlocked "list the secret names in $APP_NAME"

	security dump-keychain "$KEYCHAIN_PATH" 2>/dev/null |
		awk -F'=' '/"acct"<blob>=/ {gsub(/^[[:space:]]*"|"$/, "", $2); print $2}' |
		sort -u
}

cmd_delete() {
	require_macos_security
	local name="${1:-}"
	require_secret_name "$name"
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked "delete $name from $APP_NAME"

	security delete-generic-password \
		-a "$name" \
		-s "$(service_name_for "$name")" \
		"$KEYCHAIN_PATH" >/dev/null ||
		die "Secret not found: $name"

	say "Deleted $name."
}

cmd_doctor() {
	local ok=0

	say "$APP_NAME doctor"

	if [[ "${OSTYPE:-}" == darwin* ]]; then say "OK macOS detected"; else
		say "FAIL not macOS"
		ok=1
	fi
	if command -v security >/dev/null 2>&1; then say "OK security command available"; else
		say "FAIL security command missing"
		ok=1
	fi
	if command -v awk >/dev/null 2>&1; then say "OK awk available"; else
		say "FAIL awk missing"
		ok=1
	fi
	if command -v xxd >/dev/null 2>&1; then say "OK xxd available"; else
		say "FAIL xxd missing"
		ok=1
	fi
	if [[ -d "$CONFIG_DIR" ]]; then say "OK config dir: $CONFIG_DIR"; else say "WARN config dir missing: $CONFIG_DIR"; fi

	if command -v security >/dev/null 2>&1; then
		if keychain_exists; then say "OK keychain: $KEYCHAIN_PATH"; else say "WARN keychain missing: $KEYCHAIN_PATH"; fi
	fi

	local touchid
	touchid="$(touchid_status)"
	if [[ "$touchid" == "available" ]]; then
		say "OK Touch ID available"
	elif [[ -f "$BIOMETRIC_FLAG" ]]; then
		say "WARN Touch ID $touchid (Touch ID unlock is enabled; the keychain password will be asked instead)"
	else
		say "INFO Touch ID $touchid"
	fi

	return "$ok"
}

is_dynamic_assignment_line() {
	local line="$1"

	[[ "$line" =~ =.*\$\(.+\) ]] && return 0
	[[ "$line" =~ =.*\`.+\` ]] && return 0

	return 1
}

scan_dynamic_line() {
	local line="$1"

	[[ "$line" =~ ^[[:space:]]*# ]] && return 1
	[[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)[A-Za-z0-9_]*)=.+$ ]] || return 1

	is_dynamic_assignment_line "$line"
}

scan_candidate_line() {
	local line="$1"
	[[ "$line" =~ ^[[:space:]]*# ]] && return 1
	[[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)[A-Za-z0-9_]*)=.+$ ]]
}

scan_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0

	local n=0
	local line name kind

	while IFS= read -r line || [[ -n "$line" ]]; do
		n=$((n + 1))

		if scan_candidate_line "$line"; then
			name="${BASH_REMATCH[2]}"

			if is_dynamic_assignment_line "$line"; then
				kind="dynamic"
			else
				kind="plaintext"
			fi

			printf '%s:%s:%s:%s\n' "$file" "$n" "$name" "$kind"
		fi
	done <"$file"
}

cmd_scan_env() {
	local files=("$@")
	[[ ${#files[@]} -gt 0 ]] || files=("${SCAN_FILES[@]}")

	local found=0
	local file line name kind

	for file in "${files[@]}"; do
		while IFS=: read -r file line name kind; do
			[[ -n "${file:-}" ]] || continue
			found=1

			if [[ "$kind" == "dynamic" ]]; then
				say "$file:$line:$name:dynamic command substitution detected; skipped by import-env"
			else
				say "$file:$line:$name:plaintext"
			fi
		done < <(scan_file "$file")
	done

	if [[ "$found" -eq 0 ]]; then
		say "No plaintext env secrets found."
	fi
}

extract_assignment_value() {
	local line="$1"

	line="${line#export }"

	local value="${line#*=}"
	# Trailing whitespace (including a CR from CRLF files) is never part of the value.
	value="${value%"${value##*[![:space:]]}"}"

	# As in the shell, a comment starts at a `#` preceded by whitespace, but only
	# outside quotes, so quoted secrets may contain " #".
	local dq_comment='^"([^"]*)"[[:space:]]+#'
	local sq_comment="^'([^']*)'[[:space:]]+#"
	if [[ "$value" =~ $dq_comment || "$value" =~ $sq_comment ]]; then
		value="${BASH_REMATCH[1]}"
	elif [[ "$value" =~ ^\"(.*)\"$ ]]; then
		value="${BASH_REMATCH[1]}"
	elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
		value="${BASH_REMATCH[1]}"
	else
		value="${value%%[[:space:]]#*}"
		value="${value%"${value##*[![:space:]]}"}"
	fi

	printf '%s' "$value"
}

rewrite_imported_file() {
	local file="$1"
	local tmp="$2"
	local line name value

	while IFS= read -r line || [[ -n "$line" ]]; do
		if scan_candidate_line "$line"; then
			name="${BASH_REMATCH[2]}"

			if is_dynamic_assignment_line "$line"; then
				printf '%s\n' "$line" >>"$tmp"
				continue
			fi

			value="$(extract_assignment_value "$line")"

			if [[ -n "$value" ]]; then
				store_secret "$name" "$value"
				printf '# dev-secret imported %s and removed plaintext value\n' "$name" >>"$tmp"
				unset value
				continue
			fi
		fi

		printf '%s\n' "$line" >>"$tmp"
	done <"$file"
}

cmd_import_env() {
	require_macos_security

	local assume_yes="false"
	local files=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--yes | -y) assume_yes="true" ;;
		*) files+=("$1") ;;
		esac
		shift
	done

	[[ ${#files[@]} -gt 0 ]] || files=("${SCAN_FILES[@]}")

	keychain_exists || cmd_init >/dev/null

	local matches plaintext_matches dynamic_matches
	matches="$(for f in "${files[@]}"; do scan_file "$f"; done || true)"

	if [[ -z "$matches" ]]; then
		say "No plaintext env secrets found."
		return 0
	fi

	plaintext_matches="$(printf '%s\n' "$matches" | awk -F: '$4 == "plaintext"')"
	dynamic_matches="$(printf '%s\n' "$matches" | awk -F: '$4 == "dynamic"')"

	if [[ -n "$dynamic_matches" ]]; then
		say "Skipped dynamic env assignments:"
		printf '%s\n' "$dynamic_matches" | while IFS=: read -r file line name kind; do
			say "- $name in $file:$line uses command substitution"
		done

		say ""
		say "Import those manually after resolving the value, for example:"
		say "  gh auth token | dev-secret set NODE_AUTH_TOKEN --stdin"
		say ""
	fi

	if [[ -z "$plaintext_matches" ]]; then
		say "No plaintext env secrets to import."
		return 0
	fi

	say "Found plaintext secrets to import:"
	printf '%s\n' "$plaintext_matches" | while IFS=: read -r file line name kind; do
		say "- $name in $file:$line"
	done

	if [[ "$assume_yes" != "true" ]]; then
		local reply
		read -r -p "Import these values into Keychain and remove plaintext from files? [y/N] " reply || true
		case "$reply" in
		y | Y | yes | YES) ;;
		*) die "Aborted." ;;
		esac
	fi

	# Unlock only now, so the prompt can name the secrets just confirmed.
	ensure_unlocked "import $(printf '%s\n' "$plaintext_matches" |
		awk -F: '!seen[$(NF - 1)]++ { printf "%s%s", (n++ ? ", " : ""), $(NF - 1) }') into $APP_NAME"

	local file backup tmp timestamp
	timestamp="$(date +%Y%m%d-%H%M%S)"

	for file in "${files[@]}"; do
		[[ -f "$file" ]] || continue

		if scan_file "$file" | awk -F: '$4 == "plaintext" { found=1 } END { exit !found }'; then
			backup="${file}.bak.dev-secret.${timestamp}"
			tmp="${file}.tmp.dev-secret.${timestamp}"

			cp "$file" "$backup"
			chmod 600 "$backup" 2>/dev/null || true
			(
				umask 177
				: >"$tmp"
			)
			rewrite_imported_file "$file" "$tmp"
			mv "$tmp" "$file"

			say "Imported and cleaned: $file"
			say "Backup: $backup (delete once you have verified the migration)"
		fi
	done
}

main() {
	local cmd="${1:-help}"
	shift || true

	case "$cmd" in
	init) cmd_init "$@" ;;
	set) cmd_set "$@" ;;
	get) cmd_get "$@" ;;
	run) cmd_run "$@" ;;
	list | ls) cmd_list "$@" ;;
	delete | rm) cmd_delete "$@" ;;
	keychain) cmd_keychain "$@" ;;
	doctor) cmd_doctor "$@" ;;
	scan-env) cmd_scan_env "$@" ;;
	import-env) cmd_import_env "$@" ;;
	help | -h | --help) usage ;;
	version | --version) say "$VERSION" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
}

# Run only when executed, so tests can source this file to exercise functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
