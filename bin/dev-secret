#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

VERSION="0.1.0"
APP_NAME="dev-secret"
KEYCHAIN_NAME="${DEV_SECRET_KEYCHAIN_NAME:-dev-secrets}"
KEYCHAIN_PATH="${DEV_SECRET_KEYCHAIN_PATH:-$HOME/Library/Keychains/${KEYCHAIN_NAME}.keychain-db}"
CONFIG_DIR="${DEV_SECRET_CONFIG_DIR:-$HOME/.config/dev-secret}"
DEFAULTS_FILE="${DEV_SECRET_DEFAULTS_FILE:-$CONFIG_DIR/defaults}"
SERVICE_PREFIX="${DEV_SECRET_SERVICE_PREFIX:-it.simoneandreani.dev-secret}"
SCAN_FILES=("$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.zshenv" "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc")
LOGIN_KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
ENROLL_SERVICE="${SERVICE_PREFIX}.keychain-unlock"
ENROLL_ACCOUNT="keychain-password"

say() { printf '%s\n' "$*"; }
info() { printf '%s\n' "$*" >&2; }
die() {
	printf 'Error: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<USAGE
$APP_NAME $VERSION

Usage:
  $APP_NAME init [--defaults FILE]
  $APP_NAME set NAME [--stdin]
  $APP_NAME get NAME
  $APP_NAME run NAME [NAME ...] -- command [args...]
  $APP_NAME list
  $APP_NAME delete NAME
  $APP_NAME keychain biometric enable|disable|status
  $APP_NAME keychain lock|unlock|status
  $APP_NAME doctor
  $APP_NAME scan-env [FILE ...]
  $APP_NAME import-env [--yes] [FILE ...]
  $APP_NAME help
  $APP_NAME version
USAGE
}

require_macos_security() {
	[[ "${OSTYPE:-}" == darwin* ]] || die "$APP_NAME requires macOS because it uses the native Keychain."
	command -v security >/dev/null 2>&1 || die "macOS security command not found."
}

service_name_for() {
	printf '%s.%s' "$SERVICE_PREFIX" "$1"
}

valid_secret_name() {
	[[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

require_secret_name() {
	local name="${1:-}"
	[[ -n "$name" ]] || die "Missing secret name."
	valid_secret_name "$name" || die "Invalid secret name '$name'. Use ENV_VAR style names."
}

ensure_config_dir() {
	mkdir -p "$CONFIG_DIR"
	chmod 700 "$CONFIG_DIR" 2>/dev/null || true
}

keychain_exists() {
	security show-keychain-info "$KEYCHAIN_PATH" >/dev/null 2>&1
}

ensure_unlocked() {
	local pass
	if pass="$(security find-generic-password \
		-a "$ENROLL_ACCOUNT" \
		-s "$ENROLL_SERVICE" \
		-w \
		"$LOGIN_KEYCHAIN" 2>/dev/null)"; then
		security unlock-keychain -p "$pass" "$KEYCHAIN_PATH" || die "Keychain unlock failed."
		unset pass
	else
		security unlock-keychain "$KEYCHAIN_PATH" || die "Keychain unlock failed or was cancelled."
	fi
}

create_keychain() {
	if keychain_exists; then
		info "Keychain exists: $KEYCHAIN_PATH"
		return 0
	fi

	mkdir -p "$(dirname "$KEYCHAIN_PATH")"
	info "Creating dedicated keychain: $KEYCHAIN_PATH"
	info "macOS will prompt you for the new keychain password."

	security create-keychain -P "$KEYCHAIN_PATH"
	security set-keychain-settings -lut 3600 "$KEYCHAIN_PATH" || true
}

add_keychain_to_search_list() {
	local current=()
	local line

	while IFS= read -r line; do
		line="${line#\"}"
		line="${line%\"}"
		[[ -n "$line" && "$line" != "$KEYCHAIN_PATH" ]] && current+=("$line")
	done < <(security list-keychains -d user 2>/dev/null || true)

	security list-keychains -d user -s "$KEYCHAIN_PATH" "${current[@]}"
}

cmd_init() {
	local defaults_src=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--defaults)
			shift
			defaults_src="${1:-}"
			[[ -n "$defaults_src" ]] || die "--defaults requires a file path."
			;;
		*)
			die "Unknown init option: $1"
			;;
		esac
		shift || true
	done

	require_macos_security
	ensure_config_dir
	create_keychain
	add_keychain_to_search_list || true

	if [[ -n "$defaults_src" ]]; then
		[[ -f "$defaults_src" ]] || die "Defaults file not found: $defaults_src"
		cp "$defaults_src" "$DEFAULTS_FILE"
		chmod 600 "$DEFAULTS_FILE" 2>/dev/null || true
		say "Installed defaults file: $DEFAULTS_FILE"
	elif [[ ! -f "$DEFAULTS_FILE" ]]; then
		cat >"$DEFAULTS_FILE" <<'DEFAULTS'
# One secret name per line. Edit this file to customize setup prompts.
GITHUB_TOKEN
SENTRY_AUTH_TOKEN
DRONE_TOKEN
REDASH_TOKEN
DEFAULTS
		chmod 600 "$DEFAULTS_FILE" 2>/dev/null || true
		say "Created defaults file: $DEFAULTS_FILE"
	fi

	say "Initialized $APP_NAME."
	say "Keychain: $KEYCHAIN_PATH"

	if command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; then
		if ! security find-generic-password \
			-a "$ENROLL_ACCOUNT" \
			-s "$ENROLL_SERVICE" \
			"$LOGIN_KEYCHAIN" >/dev/null 2>&1; then
			local reply
			read -r -p "Enroll Touch ID for keychain unlock? [Y/n] " reply || true
			case "${reply:-Y}" in
			y | Y | yes | YES | "") cmd_keychain_biometric_enable ;;
			esac
		fi
	fi
}

cmd_keychain_biometric_enable() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1 || die "Touch ID not available or not enrolled on this device."

	local pass
	read -r -s -p "Keychain password: " pass
	printf '\n' >&2
	[[ -n "$pass" ]] || die "Empty password."

	security unlock-keychain -p "$pass" "$KEYCHAIN_PATH" 2>/dev/null || die "Wrong keychain password."

	security add-generic-password \
		-U \
		-a "$ENROLL_ACCOUNT" \
		-s "$ENROLL_SERVICE" \
		-w "$pass" \
		"$LOGIN_KEYCHAIN" >/dev/null
	unset pass

	say "Biometric unlock enabled."
}

cmd_keychain_biometric_disable() {
	require_macos_security
	security delete-generic-password \
		-a "$ENROLL_ACCOUNT" \
		-s "$ENROLL_SERVICE" \
		"$LOGIN_KEYCHAIN" >/dev/null 2>&1 || die "Biometric unlock is not enabled."
	say "Biometric unlock disabled."
}

cmd_keychain_biometric_status() {
	if command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; then
		say "Touch ID: available"
	else
		say "Touch ID: not available or not enrolled"
	fi
	if security find-generic-password \
		-a "$ENROLL_ACCOUNT" \
		-s "$ENROLL_SERVICE" \
		"$LOGIN_KEYCHAIN" >/dev/null 2>&1; then
		say "Enabled:   yes"
	else
		say "Enabled:   no"
	fi
}

cmd_keychain_biometric() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
	enable) cmd_keychain_biometric_enable "$@" ;;
	disable) cmd_keychain_biometric_disable "$@" ;;
	status) cmd_keychain_biometric_status "$@" ;;
	*) die "Unknown biometric subcommand '${sub}'. Use: enable, disable, status" ;;
	esac
}

cmd_keychain_lock() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	security lock-keychain "$KEYCHAIN_PATH"
	say "Keychain locked."
}

cmd_keychain_unlock() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked
	say "Keychain unlocked."
}

cmd_keychain_status() {
	require_macos_security
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	say "Keychain: $KEYCHAIN_PATH"
	security show-keychain-info "$KEYCHAIN_PATH" 2>&1 || true
	if command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; then
		say "Touch ID: available"
	else
		say "Touch ID: not available or not enrolled"
	fi
}

cmd_keychain() {
	local sub="${1:-}"
	shift || true
	case "$sub" in
	biometric) cmd_keychain_biometric "$@" ;;
	lock) cmd_keychain_lock "$@" ;;
	unlock) cmd_keychain_unlock "$@" ;;
	status) cmd_keychain_status "$@" ;;
	*) die "Unknown keychain subcommand '${sub}'. Use: biometric, lock, unlock, status" ;;
	esac
}

read_hidden_secret() {
	local name="$1"
	local value1 value2

	while true; do
		read -r -s -p "Enter value for $name: " value1 || true
		printf '\n' >&2

		[[ -n "$value1" ]] || die "Empty secret aborted."

		read -r -s -p "Confirm value for $name: " value2 || true
		printf '\n' >&2

		if [[ "$value1" == "$value2" ]]; then
			printf '%s' "$value1"
			return 0
		fi

		info "Values did not match. Try again."
	done
}

store_secret() {
	local name="$1"
	local value="$2"

	security add-generic-password \
		-U \
		-a "$name" \
		-s "$(service_name_for "$name")" \
		-D "application password" \
		-w "$value" \
		"$KEYCHAIN_PATH" >/dev/null
}

cmd_set() {
	require_macos_security

	local name="${1:-}"
	require_secret_name "$name"
	shift || true

	local mode="prompt"

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--stdin) mode="stdin" ;;
		*) die "Unknown set option: $1" ;;
		esac
		shift
	done

	keychain_exists || cmd_init >/dev/null
	ensure_unlocked

	local value
	if [[ "$mode" == "stdin" ]]; then
		[[ ! -t 0 ]] || die "--stdin requires piped input."
		value="$(cat)"
		[[ -n "$value" ]] || die "Empty secret aborted."
	else
		value="$(read_hidden_secret "$name")"
	fi

	store_secret "$name" "$value"
	unset value
	say "Stored $name."
}

get_secret() {
	local name="$1"

	security find-generic-password \
		-a "$name" \
		-s "$(service_name_for "$name")" \
		-w \
		"$KEYCHAIN_PATH"
}

cmd_get() {
	require_macos_security
	local name="${1:-}"
	require_secret_name "$name"
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked
	get_secret "$name" || die "Secret not found: $name"
}

cmd_run() {
	require_macos_security

	[[ $# -gt 0 ]] || die "Usage: $APP_NAME run NAME [NAME ...] -- command [args...]"

	local names=()
	while [[ $# -gt 0 ]]; do
		if [[ "$1" == "--" ]]; then
			shift
			break
		fi
		require_secret_name "$1"
		names+=("$1")
		shift
	done

	[[ ${#names[@]} -gt 0 ]] || die "At least one secret name is required."
	[[ $# -gt 0 ]] || die "Command missing after --."

	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked

	local env_args=()
	local name value

	for name in "${names[@]}"; do
		value="$(get_secret "$name")" || die "Secret not found: $name"
		env_args+=("$name=$value")
		unset value
	done

	env "${env_args[@]}" "$@"
}

cmd_list() {
	require_macos_security
	keychain_exists || die "Keychain not found: $KEYCHAIN_PATH"
	ensure_unlocked

	security dump-keychain "$KEYCHAIN_PATH" 2>/dev/null |
		awk -F'=' '/"acct"<blob>=/ {gsub(/^[[:space:]]*"|"$/, "", $2); print $2}' |
		sort -u
}

cmd_delete() {
	require_macos_security
	local name="${1:-}"
	require_secret_name "$name"
	keychain_exists || die "Keychain not found. Run: $APP_NAME init"
	ensure_unlocked

	security delete-generic-password \
		-a "$name" \
		-s "$(service_name_for "$name")" \
		"$KEYCHAIN_PATH" >/dev/null ||
		die "Secret not found: $name"

	say "Deleted $name."
}

cmd_doctor() {
	local ok=0

	say "$APP_NAME doctor"

	if [[ "${OSTYPE:-}" == darwin* ]]; then say "OK macOS detected"; else
		say "FAIL not macOS"
		ok=1
	fi
	if command -v security >/dev/null 2>&1; then say "OK security command available"; else
		say "FAIL security command missing"
		ok=1
	fi
	if command -v awk >/dev/null 2>&1; then say "OK awk available"; else
		say "FAIL awk missing"
		ok=1
	fi
	if [[ -d "$CONFIG_DIR" ]]; then say "OK config dir: $CONFIG_DIR"; else say "WARN config dir missing: $CONFIG_DIR"; fi

	if command -v security >/dev/null 2>&1; then
		if keychain_exists; then say "OK keychain: $KEYCHAIN_PATH"; else say "WARN keychain missing: $KEYCHAIN_PATH"; fi
	fi

	if command -v bioutil >/dev/null 2>&1 && bioutil -c >/dev/null 2>&1; then
		say "OK Touch ID available"
	else
		say "INFO Touch ID not available or not enrolled"
	fi

	return "$ok"
}

is_dynamic_assignment_line() {
	local line="$1"

	[[ "$line" =~ =.*\$\(.+\) ]] && return 0
	[[ "$line" =~ =.*\`.+\` ]] && return 0

	return 1
}

scan_dynamic_line() {
	local line="$1"

	[[ "$line" =~ ^[[:space:]]*# ]] && return 1
	[[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)[A-Za-z0-9_]*)=.+$ ]] || return 1

	is_dynamic_assignment_line "$line"
}

scan_candidate_line() {
	local line="$1"
	[[ "$line" =~ ^[[:space:]]*# ]] && return 1
	[[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASS|KEY)[A-Za-z0-9_]*)=.+$ ]]
}

scan_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0

	local n=0
	local line name kind

	while IFS= read -r line || [[ -n "$line" ]]; do
		n=$((n + 1))

		if scan_candidate_line "$line"; then
			name="${BASH_REMATCH[2]}"

			if is_dynamic_assignment_line "$line"; then
				kind="dynamic"
			else
				kind="plaintext"
			fi

			printf '%s:%s:%s:%s\n' "$file" "$n" "$name" "$kind"
		fi
	done <"$file"
}

cmd_scan_env() {
	local files=("$@")
	[[ ${#files[@]} -gt 0 ]] || files=("${SCAN_FILES[@]}")

	local found=0
	local result file line name kind

	for file in "${files[@]}"; do
		while IFS=: read -r file line name kind; do
			[[ -n "${file:-}" ]] || continue
			found=1

			if [[ "$kind" == "dynamic" ]]; then
				say "$file:$line:$name:dynamic command substitution detected; skipped by import-env"
			else
				say "$file:$line:$name:plaintext"
			fi
		done < <(scan_file "$file")
	done

	if [[ "$found" -eq 0 ]]; then
		say "No plaintext env secrets found."
	fi
}

extract_assignment_value() {
	local line="$1"

	line="${line#export }"

	local value="${line#*=}"
	value="${value%% #*}"
	value="${value%$'\r'}"

	if [[ "$value" =~ ^\"(.*)\"$ ]]; then
		value="${BASH_REMATCH[1]}"
	elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
		value="${BASH_REMATCH[1]}"
	fi

	printf '%s' "$value"
}

rewrite_imported_file() {
	local file="$1"
	local tmp="$2"
	local line name value

	while IFS= read -r line || [[ -n "$line" ]]; do
		if scan_candidate_line "$line"; then
			name="${BASH_REMATCH[2]}"

			if is_dynamic_assignment_line "$line"; then
				printf '%s\n' "$line" >>"$tmp"
				continue
			fi

			value="$(extract_assignment_value "$line")"

			if [[ -n "$value" ]]; then
				store_secret "$name" "$value"
				printf '# dev-secret imported %s and removed plaintext value\n' "$name" >>"$tmp"
				unset value
				continue
			fi
		fi

		printf '%s\n' "$line" >>"$tmp"
	done <"$file"
}

cmd_import_env() {
	require_macos_security

	local assume_yes="false"
	local files=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
		--yes | -y) assume_yes="true" ;;
		*) files+=("$1") ;;
		esac
		shift
	done

	[[ ${#files[@]} -gt 0 ]] || files=("${SCAN_FILES[@]}")

	keychain_exists || cmd_init >/dev/null
	ensure_unlocked

	local matches plaintext_matches dynamic_matches
	matches="$(for f in "${files[@]}"; do scan_file "$f"; done || true)"

	if [[ -z "$matches" ]]; then
		say "No plaintext env secrets found."
		return 0
	fi

	plaintext_matches="$(printf '%s\n' "$matches" | awk -F: '$4 == "plaintext"')"
	dynamic_matches="$(printf '%s\n' "$matches" | awk -F: '$4 == "dynamic"')"

	if [[ -n "$dynamic_matches" ]]; then
		say "Skipped dynamic env assignments:"
		printf '%s\n' "$dynamic_matches" | while IFS=: read -r file line name kind; do
			say "- $name in $file:$line uses command substitution"
		done

		say ""
		say "Import those manually after resolving the value, for example:"
		say "  gh auth token | dev-secret set NODE_AUTH_TOKEN --stdin"
		say ""
	fi

	if [[ -z "$plaintext_matches" ]]; then
		say "No plaintext env secrets to import."
		return 0
	fi

	say "Found plaintext secrets to import:"
	printf '%s\n' "$plaintext_matches" | while IFS=: read -r file line name kind; do
		say "- $name in $file:$line"
	done

	if [[ "$assume_yes" != "true" ]]; then
		local reply
		read -r -p "Import these values into Keychain and remove plaintext from files? [y/N] " reply || true
		case "$reply" in
		y | Y | yes | YES) ;;
		*) die "Aborted." ;;
		esac
	fi

	local file backup tmp timestamp
	timestamp="$(date +%Y%m%d-%H%M%S)"

	for file in "${files[@]}"; do
		[[ -f "$file" ]] || continue

		if scan_file "$file" | awk -F: '$4 == "plaintext" { found=1 } END { exit !found }'; then
			backup="${file}.bak.dev-secret.${timestamp}"
			tmp="${file}.tmp.dev-secret.${timestamp}"

			cp "$file" "$backup"
			: >"$tmp"
			rewrite_imported_file "$file" "$tmp"
			chmod 600 "$tmp" 2>/dev/null || true
			mv "$tmp" "$file"

			say "Imported and cleaned: $file"
			say "Backup: $backup"
		fi
	done
}

main() {
	local cmd="${1:-help}"
	shift || true

	case "$cmd" in
	init) cmd_init "$@" ;;
	set) cmd_set "$@" ;;
	get) cmd_get "$@" ;;
	run) cmd_run "$@" ;;
	list | ls) cmd_list "$@" ;;
	delete | rm) cmd_delete "$@" ;;
	keychain) cmd_keychain "$@" ;;
	doctor) cmd_doctor "$@" ;;
	scan-env) cmd_scan_env "$@" ;;
	import-env) cmd_import_env "$@" ;;
	help | -h | --help) usage ;;
	version | --version) say "$VERSION" ;;
	*)
		usage >&2
		exit 1
		;;
	esac
}

main "$@"
